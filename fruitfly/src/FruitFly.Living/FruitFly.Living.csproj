<Project Sdk="Microsoft.NET.Sdk">
  <!-- The CREATURES: assembled flies + the worlds they live in. Godot-free (BCL only),
       references the substrate. A class library so any viewer — Godot, the console, tests —
       can drive the same fly. See ADR 0005. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FruitFly.Core\FruitFly.Core.csproj" />
  </ItemGroup>
</Project>
